rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'sonlyhongduc@gmail.com' && request.auth.token.email_verified == true) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function canManageUsers() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', {}).get('tabUsers', false) == true
      );
    }

    function canManageConfigs() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', {}).get('tabConfigs', false) == true
      );
    }

    function isApprovedUser() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }

    match /users/{userId} {
      // User can read their own profile, super_admin or user manager can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || canManageUsers());
      // User can create their initial pending profile on sign in
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        isSuperAdmin() || (request.resource.data.role == 'user' && request.resource.data.status == 'pending')
      );
      // Only Super Admin / User Manager can update role/status/canViewRawCode/permissions, or user can update basic info (and lock canChangeWard to false after ward setup)
      allow update: if isAuthenticated() && (
        canManageUsers() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'canViewRawCode']))
      );
      allow delete: if canManageUsers();
    }

    match /configurations/{configId} {
      // Approved users, admins, and super admins can read configs
      allow read: if isApprovedUser();
      // Only super admin or user granted tabConfigs can create, modify, or delete configurations
      allow write: if canManageConfigs();
    }
  }
}
